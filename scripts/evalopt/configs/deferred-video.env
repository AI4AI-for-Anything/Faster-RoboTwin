# OPTIONAL, not the default and not part of the headline result: deferred-video mode.
# The evaluation runs without rendering the head camera for the eval video; every episode's action chunks
# are saved so that evalopt/replay_video.py can rebuild the video afterwards. Scores and every other
# per-episode fingerprint matched the official pipeline (84 jobs at 14 jobs per GPU); rebuilt mp4 files
# matched the official ones by md5 on 6 episodes only. It changes when (and for which episodes) videos
# are produced, so decide before using it.
source "$(dirname -- "${BASH_SOURCE[0]}")/faster.env"
export EVALOPT_NO_VIDEO=1          # eval_video_log off: no head frame per step during evaluation
export EVALOPT_RECORD_ACTIONS=1    # <job out>/actions/<seed>.pkl, input of replay_video.py
