# Faster-RoboTwin: switches of the measured configuration (official π0.5 evaluation, eval videos written
# as usual). Every EVALOPT_* switch is off unless set; with none set, the wrappers run the official code.
# Usage: source scripts/evalopt/configs/faster.env, then run_ms_workers.sh (one multi-session server and
# 10-14 resident workers per GPU in the measured runs). Expert-check records are per job: set "record"
# or "replay" in jobs.json (evalopt/make_jobs.py TASK:CONFIG:N:replay=PATH), not here.

# simulator side (prof_eval.py)
export EVALOPT_SKIP_UNUSED_CAMS=1    # never render the front camera (read by neither the policy nor the video)
export EVALOPT_LAZY_OBS=1            # mid-chunk steps render only the head camera (eval video), no update_obs
export EVALOPT_LAZY_CUROBO=1         # build the cuRobo planner on first use (never, with replayed expert checks)
export EVALOPT_KEEP_CACHE=1          # do not clear SAPIEN's render cache every 5 episodes
export EVALOPT_CUDA_BLOCKING_SYNC=1  # block instead of spin while waiting for the GPU (CPU only)
# EVALOPT_SERVER_NEW_JOB=1 is set by run_resident.sh: reset the reused server to key(0) at each job start

# policy server side (serve_policy.sh)
export EVALOPT_MEM_FRACTION=0.08     # JAX allocator pool share instead of the official 0.3
# EVALOPT_MULTISESSION=1 is set by run_ms_workers.sh: one server per GPU, one session per eval job
# EVALOPT_AUTOTUNE defaults to evalopt/autotune/pi05_h20_idle.textproto (H20 only; see docs/validation.md)
